<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.control.Spinner?>
<?import javafx.scene.control.Tab?>
<?import javafx.scene.control.TabPane?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<BorderPane xmlns:fx="http://javafx.com/fxml"
    fx:controller="co.edu.uniquindio.poo.controller.MainController"
    prefWidth="1100"
    prefHeight="700">

    <top>
        <VBox spacing="5"
            style="-fx-background-color: #202020;">

            <padding>
                <Insets top="18"
                    right="25"
                    bottom="18"
                    left="25" />
            </padding>

            <Label text="CinemaUQ"
                style="-fx-text-fill: white; -fx-font-size: 28px; -fx-font-weight: bold;" />

            <Label text="Compra de entradas y confiteria"
                style="-fx-text-fill: #dddddd; -fx-font-size: 14px;" />

        </VBox>
    </top>

    <center>

        <TabPane fx:id="tabPane"
            tabClosingPolicy="UNAVAILABLE">

            <!-- CARTELERA -->

            <Tab fx:id="tabCartelera"
                text="1. Cartelera">

                <VBox spacing="15">

                    <padding>
                        <Insets top="25"
                            right="30"
                            bottom="25"
                            left="30" />
                    </padding>

                    <Label text="Cartelera disponible"
                        style="-fx-font-size: 22px; -fx-font-weight: bold;" />

                    <Label text="Seleccione una pelicula" />

                    <ComboBox fx:id="cmbPeliculas"
                        prefWidth="500"
                        onAction="#cargarFunciones" />

                    <Label fx:id="lblInfoPelicula"
                        style="-fx-font-size: 14px;" />

                    <Separator />

                    <Label text="Funciones disponibles"
                        style="-fx-font-size: 17px; -fx-font-weight: bold;" />

                    <ListView fx:id="lstFunciones"
                        prefHeight="300" />

                    <Button text="Seleccionar funcion y escoger asientos"
                        onAction="#continuarAAsientos"
                        prefHeight="40"
                        style="-fx-font-weight: bold;" />

                </VBox>
            </Tab>

            <!-- ASIENTOS -->

            <Tab fx:id="tabAsientos"
                text="2. Asientos">

                <VBox spacing="15">

                    <padding>
                        <Insets top="25"
                            right="30"
                            bottom="25"
                            left="30" />
                    </padding>

                    <Label text="Seleccione sus asientos"
                        style="-fx-font-size: 22px; -fx-font-weight: bold;" />

                    <Label fx:id="lblFuncionAsientos" />

                    <Label text="Verde: disponible | Azul: seleccionado | Gris: ocupado" />

                    <ScrollPane fitToWidth="true"
                        prefHeight="380">

                        <GridPane fx:id="gridAsientos"
                            alignment="CENTER"
                            hgap="10"
                            vgap="10">

                            <padding>
                                <Insets top="20"
                                    right="20"
                                    bottom="20"
                                    left="20" />
                            </padding>

                        </GridPane>

                    </ScrollPane>

                    <Label fx:id="lblAsientosSeleccionados"
                        style="-fx-font-weight: bold;" />

                    <Button text="Continuar a confiteria"
                        onAction="#continuarAConfiteria"
                        prefHeight="40"
                        style="-fx-font-weight: bold;" />

                </VBox>
            </Tab>

            <!-- CONFITERIA -->

            <Tab fx:id="tabConfiteria"
                text="3. Confiteria">

                <VBox spacing="18">

                    <padding>
                        <Insets top="25"
                            right="30"
                            bottom="25"
                            left="30" />
                    </padding>

                    <Label text="Confiteria"
                        style="-fx-font-size: 22px; -fx-font-weight: bold;" />

                    <Label
                        text="Puede agregar productos individuales o combos. La confiteria es opcional." />

                    <Separator />

                    <Label text="Productos"
                        style="-fx-font-size: 17px; -fx-font-weight: bold;" />

                    <HBox spacing="10">

                        <ComboBox fx:id="cmbProductos"
                            prefWidth="420" />

                        <Spinner fx:id="spnProducto"
                            prefWidth="80" />

                        <Button text="Agregar producto"
                            onAction="#agregarProducto" />

                    </HBox>

                    <Label text="Combos"
                        style="-fx-font-size: 17px; -fx-font-weight: bold;" />

                    <HBox spacing="10">

                        <ComboBox fx:id="cmbCombos"
                            prefWidth="420" />

                        <Spinner fx:id="spnCombo"
                            prefWidth="80" />

                        <Button text="Agregar combo"
                            onAction="#agregarCombo" />

                    </HBox>

                    <Separator />

                    <Label text="Carrito"
                        style="-fx-font-size: 17px; -fx-font-weight: bold;" />

                    <TextArea fx:id="txtCarrito"
                        editable="false"
                        prefHeight="180"
                        wrapText="true" />

                    <HBox spacing="10">

                        <Button text="Limpiar confiteria"
                            onAction="#limpiarConfiteria" />

                        <Button text="Continuar a compra"
                            onAction="#continuarACompra"
                            style="-fx-font-weight: bold;" />

                    </HBox>

                </VBox>
            </Tab>

            <!-- COMPRA -->

            <Tab fx:id="tabCompra"
                text="4. Compra">

                <VBox spacing="14">

                    <padding>
                        <Insets top="25"
                            right="30"
                            bottom="25"
                            left="30" />
                    </padding>

                    <Label text="Resumen y pago"
                        style="-fx-font-size: 22px; -fx-font-weight: bold;" />

                    <HBox spacing="30">

                        <Label fx:id="lblCliente"
                            style="-fx-font-weight: bold;" />

                        <Label fx:id="lblSaldo"
                            style="-fx-font-weight: bold;" />

                    </HBox>

                    <Separator />

                    <TextArea fx:id="txtResumen"
                        editable="false"
                        prefHeight="260"
                        wrapText="true" />

                    <Label fx:id="lblPromocion" />

                    <Label fx:id="lblSubtotal" />

                    <Label fx:id="lblTotal"
                        style="-fx-font-size: 20px; -fx-font-weight: bold;" />

                    <Button text="Confirmar y pagar con tarjeta virtual"
                        onAction="#confirmarCompra"
                        prefHeight="45"
                        style="-fx-font-size: 15px; -fx-font-weight: bold;" />

                </VBox>
            </Tab>

        </TabPane>

    </center>

</BorderPane>